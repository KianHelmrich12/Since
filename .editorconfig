root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cpp,h,hpp,ino}]
indent_size = 2
max_line_length = 100

[*.{ini,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{LICENSE,*/LICENSE}]
trim_trailing_whitespace = false
insert_final_newline = unset
